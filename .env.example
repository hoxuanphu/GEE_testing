# GEE service account key (bạn điền vào biến môi trường hoặc đặt tại đây)
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
GEE_KEY_FILE=ee_private_key.json

# Copernicus Data Space (tải Sentinel-1 GRD/SLC ZIP)
# Đăng ký miễn phí tại https://dataspace.copernicus.eu/
# Lưu ý: tải ZIP dùng password-grant (username/password đăng nhập CDSE, không phải
# OAuth Client của Sentinel Hub). Tài khoản phải tắt 2FA.
CDSE_USERNAME=you@example.com
CDSE_PASSWORD=your-cdse-password
Client ID=your-client-id
Client secret=your-client-secret
# App
APP_HOST=127.0.0.1
APP_PORT=8000
