# GEE service account key (bạn điền vào biến môi trường hoặc đặt tại đây)
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
GEE_KEY_FILE=ee_private_key.json

# Copernicus Data Space: S3 downloads use Access_Key_S3 / Secret_Key_S3 below.
# Create keys at https://eodata-s3keysmanager.dataspace.copernicus.eu/
# Store real keys in ignored .env or server environment, never in this example.
# CDSE_USERNAME / CDSE_PASSWORD are only for legacy OData endpoints.
CDSE_USERNAME=you@example.com
CDSE_PASSWORD=your-cdse-password
Client_ID_CDSE=
Client_Secret_CDSE=
Secret_Key_S3=
Access_Key_S3=
# Optional catalogue-only EODAG backend (install requirements-eodag.txt separately).
EODAG_ENABLED=false
EODAG_PROVIDERS=earth_search,planetary_computer
EODAG_CONFIG_FILE=
EODAG_MAX_RESULTS=4000
# Reserved for a future release; no MVP behavior.
EODAG_QUICKLOOK_MAX_BYTES=10485760

# App
APP_HOST=127.0.0.1
APP_PORT=8000
